# 로컬 개발용 예시. 복사해서 .env로 쓰고, 실제 비밀값은 커밋하지 않는다.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dongle
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 메일은 가상 메일함 Mailpit으로 보낸다(README 「인증 메일 확인」). 배포에서는 EMAIL_HOST가 필수다.
# 로컬은 EMAIL_HOST를 비워 두면 인증 코드를 콘솔에 출력한다.
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# 실제 SMTP(Gmail 등)를 쓸 때만 아래를 넣는다. Gmail은 587, TLS True, 앱 비밀번호 16자(공백 없이).
# DEFAULT_FROM_EMAIL=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=False

# 시연 때 True로 두면 모든 편지가 1분 뒤 도착한다.
LETTER_DEMO_MODE=False
