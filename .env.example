# 로컬 개발용 예시. 복사해서 .env로 쓰고, 실제 비밀값은 커밋하지 않는다.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dongle
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 배포에서는 필수. 로컬은 EMAIL_HOST를 넣으면 실제 메일을 보내고, 비워 두면 인증 코드를 콘솔에 출력한다.
# Gmail 앱 비밀번호는 공백 없이 16자로 넣는다.
# DEFAULT_FROM_EMAIL=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# 시연 때 True로 두면 모든 편지가 1분 뒤 도착한다.
LETTER_DEMO_MODE=False
