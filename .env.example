# 로컬 개발용 예시. 복사해서 .env로 쓰고, 실제 비밀값은 커밋하지 않는다.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dongle
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 인증 메일. 로컬은 EMAIL_HOST를 비워 두면 인증 코드를 콘솔에 출력한다.
# 가상 메일함 Mailpit으로 받으려면(README 「인증 메일 확인」):
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# 실제 사용자 메일함으로 보내려면 아래를 모두 넣는다(README 「실제 메일 발송」). Gmail 예시:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=보내는계정@gmail.com
# EMAIL_HOST_PASSWORD=앱비밀번호16자(공백 없이)
# DEFAULT_FROM_EMAIL=동글 <보내는계정@gmail.com>

# 시연 때 True로 두면 모든 편지가 1분 뒤 도착한다.
LETTER_DEMO_MODE=False

# 컨테이너 배포(compose.yaml, README 「홈서버 배포」)에서 쓰는 값. 로컬 runserver에는 필요 없다.
# POSTGRES_PASSWORD=   # DB 비밀번호. compose가 DATABASE_URL을 만들 때 쓴다
# CSRF_TRUSTED_ORIGINS=https://API-주소   # https 뒤에서 admin 로그인을 쓸 때
# MEDIA_ROOT=          # 업로드 이미지 저장 경로. compose가 /app/media로 정한다
# SERVE_MEDIA=false    # DEBUG=False에서 /media/를 Django가 직접 줄지. compose가 true로 정한다
# DEMO_SEED=false      # true면 배포 때 compose의 demo-seed가 시연 데이터를 다시 만든다 (README 「시연 준비」)
# DEMO_ARRIVE_IN=3     # 시연 중 도착할 편지가 몇 분 뒤 도착할지
# SECURE_HSTS_SECONDS=86400   # prod HSTS 유지 시간(초). 기본 1일
# MAILPIT_UI_AUTH=     # Mailpit 웹 화면·API 비밀번호 "사용자:비밀번호". 비우면 비밀번호 없이 열린다
