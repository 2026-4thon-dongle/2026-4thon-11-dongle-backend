# 로컬 개발용 예시. 복사해서 .env로 쓰고, 실제 비밀값은 커밋하지 않는다.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dongle
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 배포에서만 쓴다. 로컬은 인증 코드를 콘솔에 출력한다.
# DEFAULT_FROM_EMAIL=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
